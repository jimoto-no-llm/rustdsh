ARG BASE_IMAGE
FROM ${BASE_IMAGE}
# install.sh needs bash, curl, tar, gzip, a checksum tool and the install(1)
# command. Isolated runs use --network=none, so everything is baked in here and
# this image is only ever built with network access.
USER root
RUN set -eux; \
    if command -v apk >/dev/null 2>&1; then \
      apk add --no-cache bash curl tar gzip coreutils ca-certificates; \
    elif command -v apt-get >/dev/null 2>&1; then \
      apt-get update; \
      DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        bash curl tar gzip coreutils ca-certificates; \
      rm -rf /var/lib/apt/lists/*; \
    elif command -v dnf >/dev/null 2>&1; then \
      # RHEL clones ship coreutils-single and curl-minimal; --allowerasing lets
      # curl replace curl-minimal instead of failing the transaction. \
      dnf install -y --allowerasing bash curl tar gzip ca-certificates; \
      dnf clean all; \
    else \
      echo "unsupported base image for the install test" >&2; exit 1; \
    fi
# Non-root install cases run as uid 1000 with HOME=/home/tester.
RUN mkdir -p /home/tester && chmod 777 /home/tester
