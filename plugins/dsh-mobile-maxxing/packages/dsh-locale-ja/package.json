{
  "name": "dsh-locale-ja",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Optional Japanese locale package for DSH: the sole ja language and namespace owner, released only when every key has a reviewed Japanese entry and no value falls back to English.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/upstream.json": "./locale/upstream.json",
    "./locale/batches.json": "./locale/batches.json",
    "./locale/translation-status.json": "./locale/translation-status.json",
    "./locale/namespaces/en/*.json": "./locale/namespaces/en/*.json",
    "./locale/namespaces/ja/*.json": "./locale/namespaces/ja/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "locale/upstream.json",
    "locale/batches.json",
    "locale/translation-status.json",
    "locale/namespaces/en/*.json",
    "locale/namespaces/ja/*.json",
    "README.md",
    "LICENSE",
    "NOTICE",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": "kuraneko1",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "locale",
    "japanese",
    "i18n"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuraneko1/dsh-mobile-maxxing.git",
    "directory": "packages/dsh-locale-ja"
  },
  "homepage": "https://github.com/kuraneko1/dsh-mobile-maxxing/tree/main/packages/dsh-locale-ja#readme",
  "bugs": {
    "url": "https://github.com/kuraneko1/dsh-mobile-maxxing/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2 || 0.2.1-rc.3"
  }
}
