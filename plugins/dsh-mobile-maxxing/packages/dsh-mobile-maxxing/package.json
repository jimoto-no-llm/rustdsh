{
  "name": "dsh-mobile-maxxing",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "DSH Web GUI をインストール可能なアプリにし、スマホ/タブレット向けUX・通知・小物をまとめて改善する統合プラグイン",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon-192.png"
  },
  "files": [
    "index.js",
    "client.js",
    "sw.js",
    "notify",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "assets/*.png",
    "assets/*.svg",
    "docs/*.png",
    "docs/*.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "e2e": "node tests/e2e.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "meta": {
    "title": "dsh-mobile-maxxing",
    "description": "PWA化、スマホ/タブレットの操作感、通知（アプリ内バナーとWeb Push）、CJK表示の修正をまとめて提供します。"
  },
  "author": "kuraneko1",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "pwa",
    "mobile",
    "ios",
    "web-push",
    "japanese"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuraneko1/dsh-mobile-maxxing.git",
    "directory": "packages/dsh-mobile-maxxing"
  },
  "homepage": "https://github.com/kuraneko1/dsh-mobile-maxxing/tree/main/packages/dsh-mobile-maxxing#readme",
  "bugs": {
    "url": "https://github.com/kuraneko1/dsh-mobile-maxxing/issues"
  }
}
