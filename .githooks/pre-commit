#!/bin/sh
# rustdsh pre-commit: block leftover conflict markers and unformatted Rust.
# Enabled by `sh scripts/dev-setup.sh` (core.hooksPath=.githooks).
# Skip once with `git commit --no-verify`, or set RDSH_SKIP_HOOKS=1.
set -eu
[ "${RDSH_SKIP_HOOKS:-}" = 1 ] && exit 0

# Conflict markers on added lines only; existing fixtures are left alone.
markers=$(git diff --cached --no-color -U0 --diff-filter=ACMR \
  | awk '/^\+\+\+ /{file=substr($0,7); next}
         /^\+(<<<<<<<|>>>>>>>|\|\|\|\|\|\|\|) /{print "  " file ": " substr($0,2)}')
if [ -n "$markers" ]; then
  echo "pre-commit: unresolved conflict markers staged:" >&2
  printf '%s\n' "$markers" >&2
  exit 1
fi

git diff --cached --quiet --diff-filter=ACMR -- '*.rs' && exit 0
if ! command -v rustfmt >/dev/null 2>&1; then
  echo "pre-commit: rustfmt not found (rustup component add rustfmt); or commit with --no-verify" >&2
  exit 1
fi

# Format-check the staged content, not the working tree: export the index
# copies of all Rust files (staged modules may load unstaged children).
snap=$(mktemp -d 2>/dev/null || mktemp -d -t rdsh-precommit)
trap 'rm -rf "$snap"' EXIT INT TERM
snap=$(cd "$snap" && pwd -P)
git ls-files -z -- '*.rs' rustfmt.toml .rustfmt.toml | git checkout-index -z --stdin --prefix="$snap/"
edition=$(git show :Cargo.toml 2>/dev/null | sed -n 's/^edition *= *"\([0-9]*\)".*/\1/p' | head -n 1)
git diff --cached --name-only -z --diff-filter=ACMR -- '*.rs' > "$snap/.staged"

rc=0
(cd "$snap" && xargs -0 rustfmt --check --edition "${edition:-2021}" < .staged) \
  > "$snap/.out" 2> "$snap/.err" || rc=$?

# Only the staged files decide; diffs in unstaged index copies are not this commit's.
diffs="$snap/.out"
native_snap="$snap"
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*)
    native_snap=$(cygpath -am "$snap")
    # Windows rustfmt reports native paths, sometimes with an extended path prefix.
    tr '\134' '/' < "$snap/.out" \
      | sed -e 's@^Diff in //?/UNC/@Diff in //@' -e 's@^Diff in //?/@Diff in @' > "$snap/.diffs"
    diffs="$snap/.diffs" ;;
esac
bad=$(tr '\0' '\n' < "$snap/.staged" | while IFS= read -r f; do
  if grep -Fq "Diff in $snap/$f:" "$diffs" || grep -Fq "Diff in $native_snap/$f:" "$diffs"; then printf ' %s' "$f"; fi
done)
if [ -n "$bad" ]; then
  echo "pre-commit: staged Rust is not formatted:$bad. Run: cargo fmt && git add" >&2
  exit 1
fi
# Any diagnostic on stderr (error:, Error writing files: ...) with a failing exit, or a
# failing exit without diffs, means rustfmt did not check everything.
if [ "$rc" != 0 ] && { [ -s "$snap/.err" ] || ! grep -q '^Diff in ' "$snap/.out"; }; then
  # rustfmt could not run or parse: never treat that as formatted.
  echo "pre-commit: rustfmt failed on the staged files (exit $rc):" >&2
  sed "s|$snap/||g" "$snap/.err" >&2
  exit 1
fi
