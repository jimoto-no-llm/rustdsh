+            .success());
+        assert!(fixture
+            .run(&["settings", "unset", "discord.application_id"])
+            .status
+            .success());
+        let reset: serde_json::Value = serde_json::from_str(&fixture.read()).unwrap();
+        assert_eq!(reset["discord"]["application_id"], "1557873849280888903");
+    }
