+/// Print the last `tail` lines by reading only the file's tail bytes.
+/// Falls back to a full read for tiny files or unreadable metadata.
+fn tail_file(path: &std::path::Path, tail: usize) -> anyhow::Result<()> {
+    use std::io::{Read, Seek, SeekFrom, Write};
+    if tail == 0 {
+        eprintln!("[rdsh] 0 line(s)");
+        return Ok(());
+    }
+    let mut f = std::fs::File::open(path)?;
+    let len = f.metadata().map(|m| m.len()).unwrap_or(0);
+    // ~256 bytes/line heuristic, clamped; big enough that one read suffices.
+    let want = (tail as u64).saturating_mul(256).clamp(4096, 8 << 20);
+    let (skip_first, text) = if want < len {
+        f.seek(SeekFrom::End(-(want as i64)))?;
+        let mut buf = Vec::with_capacity(want as usize + 1);
+        f.read_to_end(&mut buf)?;
+        // First line may start mid-line (or mid-char): drop it.
+        (true, String::from_utf8_lossy(&buf).into_owned())
+    } else {
+        let mut s = String::new();
+        f.read_to_string(&mut s)?;
+        (false, s)
+    };
+    let mut lines: Vec<&str> = text.lines().collect();
+    if skip_first && !lines.is_empty() {
+        lines.remove(0);
+    }
+    let start = lines.len().saturating_sub(tail);
+    let stdout = std::io::stdout();
+    let mut out = std::io::BufWriter::new(stdout.lock());
+    for l in &lines[start..] {
+        let _ = writeln!(out, "{l}");
+    }
+    let _ = out.flush();
+    eprintln!("[rdsh] showing last {} line(s)", lines.len() - start);
+    Ok(())
+}
